# Docker Compose loads this file when copied to .env. dotnet run does NOT load it.
Mongo__ConnectionString=mongodb://mongo:27017
Mongo__Database=jay_portfolio
ASPNETCORE_ENVIRONMENT=Development
AllowedHosts=localhost
# Admin setup: supply these only to the setup process; never save a real password here.
PORTFOLIO_ADMIN_EMAIL=
PORTFOLIO_ADMIN_PASSWORD=
