@model PublicModel
@{ var kind = (string)ViewData["Kind"]!; ViewData["Title"] = char.ToUpper(kind[0]) + kind[1..]; var items = Model.Content.Where(x => x.Kind == kind).ToList(); }
<section class="wrap section narrow"><p class="eyebrow">JAY CARLO / @kind.ToUpperInvariant()</p><h1>@ViewData["Title"]<span class="blue">.</span></h1>
@if (kind == "about") { var about = Model.Content.FirstOrDefault(x => x.Kind == "sections" && x.Key == "about"); <h2>@about?.Title</h2><p class="preserve">@about?.Content</p><p>@Model.Settings?.Content</p><a class="button primary" href="/contact">Let’s talk ↗</a> }
else if (!items.Any()) { <p class="empty">This page is being prepared. Check back soon.</p> }
@foreach (var item in items) { <article class="content-entry"><p class="eyebrow">@item.Subtitle</p><h2>@item.Title</h2>@if (item.StartDate != null) { <p>@item.StartDate?.ToString("MMM yyyy") — @(item.EndDate?.ToString("MMM yyyy") ?? "Present")</p> }<p class="preserve">@item.Content</p>@if (!string.IsNullOrEmpty(item.Url)) { <a class="text-link" href="@item.Url" rel="noopener noreferrer">View details ↗</a> }@if (kind == "resume" && Model.Media.FirstOrDefault(x => x.Id == item.MediaId) is MediaAsset resume) { <p><a class="button primary" href="@resume.Url">Download CV (PDF) ↓</a></p><p>The resume summary above is a text preview. The PDF downloads securely for viewing in your preferred reader.</p> }</article> }</section>

