@model CaseStudyModel
@{ var p = Model.Project; ViewData["Title"] = string.IsNullOrEmpty(p.SeoTitle) ? p.Title : p.SeoTitle; ViewData["Description"] = string.IsNullOrEmpty(p.SeoDescription) ? p.Summary : p.SeoDescription; }
<article class="wrap section case-study">@if (Model.Preview) { <div class="notice">Private preview · @p.Visibility · <a href="/admin/projects/@p.Id/edit">Return to editor</a></div> }<a class="text-link" href="/projects">← All projects</a><p class="eyebrow">CASE STUDY / @p.ProjectStatus</p><h1>@p.Title</h1><p class="hero-description">@p.Summary</p><div class="badges">@foreach (var tech in p.Technologies) { <span>@tech</span> }</div>
@if (Model.Media.FirstOrDefault(x => x.Id == p.CoverImageId) is MediaAsset cover) { <img class="case-cover" src="@cover.Url" alt="@cover.AltText" /> }
<div class="case-grid"><aside><p class="eyebrow">MY ROLE</p><p>@p.Role</p><p class="eyebrow">TIMELINE</p><p>@(p.StartDate?.ToString("MMM yyyy") ?? "To be added") — @(p.EndDate?.ToString("MMM yyyy") ?? "To be added")</p><div class="link-list">@if (!string.IsNullOrEmpty(p.GitHubUrl)) { <a href="@p.GitHubUrl" rel="noopener noreferrer">Source code ↗</a> }@if (!string.IsNullOrEmpty(p.DemoUrl)) { <a href="@p.DemoUrl" rel="noopener noreferrer">Live demo ↗</a> }@if (!string.IsNullOrEmpty(p.CaseStudyUrl)) { <a href="@p.CaseStudyUrl" rel="noopener noreferrer">Further reading ↗</a> }</div></aside><div>
@foreach (var part in new[] { ("Overview",p.Description), ("The problem",p.ProblemStatement), ("The solution",p.Solution), ("Architecture",p.Architecture) }) { @if (!string.IsNullOrEmpty(part.Item2)) { <section><h2>@part.Item1</h2><p class="preserve">@part.Item2</p></section> } }
@foreach (var group in new[] { ("My contribution",p.Responsibilities), ("Features",p.Features), ("Results",p.Outcomes) }) { @if (group.Item2.Any()) { <section><h2>@group.Item1</h2><ul>@foreach (var line in group.Item2) { <li>@line</li> }</ul></section> } }
</div></div><div class="gallery">@foreach (var id in p.GalleryImageIds) { var asset = Model.Media.FirstOrDefault(x => x.Id == id); if (asset != null) { <figure><img src="@asset.Url" alt="@asset.AltText" loading="lazy" /><figcaption>@asset.AltText</figcaption></figure> } }</div></article>
