@model PublicModel
@{ ViewData["Title"] = "Projects"; }
<section class="wrap section"><p class="eyebrow">IDEAS INTO IMPLEMENTATION</p><h1>Selected work<span class="blue">.</span></h1><p class="section-intro">Enterprise systems, thoughtful interfaces, and connected solutions.</p>
<form method="get" class="filters"><label>Search<input name="q" value="@Context.Request.Query["q"]" placeholder="Find a project" /></label><label>Category<select name="category"><option value="">All categories</option>@foreach (var category in Model.Content.Where(x => x.Kind == "categories")) { <option value="@category.Id" selected="@(Context.Request.Query["category"] == category.Id)">@category.Title</option> }</select></label><label>Technology<input name="technology" value="@Context.Request.Query["technology"]" placeholder="e.g. C#" /></label><button class="button primary">Filter</button><a class="text-link" href="/projects">Reset</a></form>
<p class="eyebrow">@Model.Total PROJECTS</p><div class="project-grid">@foreach (var project in Model.Projects) { <partial name="_ProjectCard" model="new CaseStudyModel(project, Model.Media, false)" /> }</div>
@if (!Model.Projects.Any()) { <p class="empty">No projects match these filters. Try another search.</p> }
<nav class="pagination" aria-label="Project pages">@if (Model.Page > 1) { <a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/projects", new Dictionary<string,string?> { ["q"] = Context.Request.Query["q"], ["category"] = Context.Request.Query["category"], ["technology"] = Context.Request.Query["technology"], ["page"] = (Model.Page - 1).ToString() })">← Previous</a> }<span>Page @Model.Page</span>@if (Model.Page * 9 < Model.Total) { <a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/projects", new Dictionary<string,string?> { ["q"] = Context.Request.Query["q"], ["category"] = Context.Request.Query["category"], ["technology"] = Context.Request.Query["technology"], ["page"] = (Model.Page + 1).ToString() })">Next →</a> }</nav></section>
