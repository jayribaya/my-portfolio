@model ContactForm
@{ ViewData["Title"] = "Contact"; }
<section class="wrap section"><div class="split"><div><p class="eyebrow">LET’S CONNECT</p><h1>A good conversation.<br />A great beginning<span class="blue">.</span></h1><p>Tell me what you’re working on, what you need, or simply say hello.</p><p class="muted">Your name, email, and message are saved privately for a reply. Submissions are automatically removed after 90 days. Please avoid sending sensitive information.</p></div><form method="post" action="/contact" class="panel form-stack">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Name"></label><input asp-for="Name" autocomplete="name" maxlength="100" /><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><label asp-for="Message"></label><textarea asp-for="Message" rows="7" maxlength="4000" placeholder="A little about your project…"></textarea><div class="honeypot" aria-hidden="true"><label asp-for="Website"></label><input asp-for="Website" tabindex="-1" autocomplete="off" /></div><button class="button primary">Send message ↗</button></form></div></section>
