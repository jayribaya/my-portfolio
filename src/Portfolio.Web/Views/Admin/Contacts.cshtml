@model List<ContactSubmission>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Contact inbox"; }
<p class="eyebrow">CONVERSATIONS</p><h1>Contact inbox</h1><p>Messages expire after 90 days. Delete them sooner when no longer needed.</p>@foreach (var c in Model.OrderByDescending(x => x.CreatedAt)) { <article class="panel contact-entry"><div class="section-heading"><div><h2>@c.Name</h2><p>@c.Email · @c.CreatedAt.ToString("yyyy-MM-dd HH:mm") UTC</p></div><span class="badge">@(c.IsRead ? "Read" : "New")</span></div><p class="preserve">@c.Message</p><div class="actions"><form method="post" action="/admin/contacts/@c.Id/action">@Html.AntiForgeryToken()<button class="button secondary">Mark read</button></form><form method="post" action="/admin/contacts/@c.Id/action" data-confirm="Permanently delete this message?">@Html.AntiForgeryToken()<input type="hidden" name="delete" value="true" /><button class="button danger">Delete</button></form></div></article> }@if (!Model.Any()) { <p class="empty">No messages yet.</p> }
