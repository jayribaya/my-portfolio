@model ProjectListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Projects"; var byId = Model.Projects.ToDictionary(x => x.Id); }
<div class="section-heading"><div><p class="eyebrow">CONTENT / PROJECTS</p><h1>Your selected work</h1><p>Publish, refine, and put your best work first.</p></div><div class="actions"><a class="button secondary" href="/admin/order/projects">Order all projects</a><a class="button primary" href="/admin/projects/new">+ New project</a></div></div>
<form method="get" class="filters"><label>Search<input name="q" value="@Context.Request.Query["q"]" placeholder="Project title" /></label><label>Visibility<select name="visibility"><option value="">All visibility</option>@foreach (var value in new[] { "Published", "Draft", "Archived", "Deleted" }) { <option selected="@(Context.Request.Query["visibility"] == value)">@value</option> }</select></label><label>Category<select name="category"><option value="">All categories</option>@foreach (var c in Model.Categories) { <option value="@c.Id" selected="@(Context.Request.Query["category"] == c.Id)">@c.Title</option> }</select></label><button class="button secondary">Filter</button><a href="/admin/projects">Reset</a></form>
@if (Model.Filtered) { <p class="notice">Ordering is available on the complete unfiltered list. <a href="/admin/projects">Reset filters</a> to preserve global ordering.</p> }
<p class="muted">Drag the handle or use ↑ / ↓, then save the order. Deleted projects retain their place for restoration.</p>
<form id="bulk-form" method="post" action="/admin/projects/bulk" class="filters" data-confirm="Apply this action to all selected projects? Each project will be version checked.">@Html.AntiForgeryToken()<label>Selected project action<select name="action"><option value="publish">Publish</option><option value="unpublish">Unpublish</option><option value="archive">Archive</option><option value="delete">Soft delete</option><option value="restore">Restore to draft</option></select></label><button class="button secondary">Apply to selected</button></form><div class="panel order-panel" data-endpoint="/admin/api/projects/reorder" data-version="@Model.GlobalOrder.Version" data-disabled="@Model.Filtered.ToString().ToLowerInvariant()"><div class="table-wrap"><table><thead><tr><th>Select / order</th><th>Project</th><th>Visibility</th><th>Work status</th><th>Actions</th></tr></thead><tbody data-sortable>@foreach (var p in Model.Projects) { <tr data-id="@p.Id"><td><input type="checkbox" form="bulk-form" name="selected" value="@(p.Id + ":" + p.Version)" aria-label="Select @p.Title" /><span class="drag-handle" aria-hidden="true">⠿</span><button class="move-up icon-button" type="button" aria-label="Move @p.Title up">↑</button><button class="move-down icon-button" type="button" aria-label="Move @p.Title down">↓</button></td><td><a href="/admin/projects/@p.Id/edit"><strong>@p.Title</strong></a><p class="muted">/@p.Slug @(p.IsFeatured ? "· Featured" : "")</p></td><td><span class="badge">@(p.DeletedAt != null ? "Deleted" : p.Visibility.ToString())</span></td><td>@p.ProjectStatus</td><td><div class="row-actions"><a href="/admin/projects/@p.Id/edit">Edit</a><a href="/admin/projects/@p.Id/preview">Preview</a><form method="post" action="/admin/projects/@p.Id/action" data-confirm="Apply this project visibility change?">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@p.Version" /><select name="action" aria-label="Action for @p.Title">@if (p.DeletedAt != null || p.Visibility == Visibility.Archived) { <option value="restore">Restore to draft</option> } else { <option value="publish">Publish</option><option value="unpublish">Unpublish</option><option value="archive">Archive</option> }<option value="delete">Soft delete</option></select><button class="button small secondary">Apply</button></form></div></td></tr> }</tbody></table></div><button class="save-order button primary" type="button" disabled="@Model.Filtered">Save project order</button></div>
@if (!Model.Projects.Any()) { <p class="empty">No projects found. Create your first project or reset your filters.</p> }
<nav class="pagination" aria-label="Admin project pages">@if (Model.Page > 1) { <a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin/projects", new Dictionary<string,string?> { ["q"] = Context.Request.Query["q"], ["visibility"] = Context.Request.Query["visibility"], ["category"] = Context.Request.Query["category"], ["page"] = (Model.Page - 1).ToString() })">Previous</a> }<span>Page @Model.Page · @Model.Total records</span>@if (Model.Page * 30 < Model.Total) { <a href="@Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin/projects", new Dictionary<string,string?> { ["q"] = Context.Request.Query["q"], ["visibility"] = Context.Request.Query["visibility"], ["category"] = Context.Request.Query["category"], ["page"] = (Model.Page + 1).ToString() })">Next</a> }</nav>
@if (!Model.Filtered) { <section class="panel order-panel" data-endpoint="/admin/api/featured/reorder" data-version="@Model.FeaturedOrder.Version"><h2>Featured project order</h2><p>Independent of the gallery order. Only pinned, active projects belong here.</p><ul class="sortable-list" data-sortable>@foreach (var id in Model.FeaturedOrder.Ids) { if (byId.TryGetValue(id, out var p)) { <li data-id="@id"><span class="drag-handle" aria-hidden="true">⠿</span><strong>@p.Title</strong><button type="button" class="move-up icon-button" aria-label="Move @p.Title up">↑</button><button type="button" class="move-down icon-button" aria-label="Move @p.Title down">↓</button></li> } }</ul><button class="save-order button primary" type="button">Save featured order</button></section> }
