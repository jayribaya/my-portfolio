@model ContentItem
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Edit " + Model.Kind; var media = (List<MediaAsset>)ViewData["Media"]!; }
<a href="/admin/content/@Model.Kind" class="text-link">← @Model.Kind</a><h1>@(Model.Version == 0 ? "New entry" : Model.Title)</h1><form method="post" action="/admin/content/save" class="panel form-stack editor">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><input asp-for="Kind" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="Title">@(Model.Kind == "settings" ? "Portfolio name" : "Title")</label><input asp-for="Title" required maxlength="160" /><label asp-for="Subtitle">@(Model.Kind == "settings" ? "Professional title" : "Subtitle / employer / institution")</label><input asp-for="Subtitle" maxlength="400" /><label asp-for="Content">Content / description (plain text)</label><textarea asp-for="Content" rows="10" maxlength="16000"></textarea><label class="checkbox"><input asp-for="IsEnabled" /> Visible on public pages</label><label asp-for="SortOrder">Display order (lower values first)</label><input asp-for="SortOrder" type="number" />
@if (Model.Kind == "sections") { <label asp-for="Key">Section type</label><select asp-for="Key">@foreach (var key in PortfolioService.SectionKeys) { <option value="@key">@key</option> }</select><label asp-for="Configuration.ItemLimit">Maximum items</label><input asp-for="Configuration.ItemLimit" type="number" min="1" max="24" /><label asp-for="Configuration.ButtonLabel">Button label</label><input asp-for="Configuration.ButtonLabel" /><label asp-for="Configuration.ButtonUrl">Button path or HTTPS URL</label><input asp-for="Configuration.ButtonUrl" /> }
else { <input asp-for="Key" type="hidden" /><input asp-for="Configuration.ItemLimit" type="hidden" /><input asp-for="Configuration.ButtonLabel" type="hidden" /><input asp-for="Configuration.ButtonUrl" type="hidden" /> }
<div class="form-grid"><div><label asp-for="StartDate">Start / issued date</label><input asp-for="StartDate" type="date" /></div><div><label asp-for="EndDate">End / expiry date</label><input asp-for="EndDate" type="date" /></div></div><label asp-for="Url">@(Model.Kind == "settings" ? "Professional profile URL (HTTPS)" : "External URL (HTTPS)")</label><input asp-for="Url" type="url" />
@if (Model.Kind == "resume") { <label asp-for="MediaId">Resume PDF</label><select asp-for="MediaId"><option value="">Choose an uploaded PDF</option>@foreach (var asset in media.Where(x => x.ContentType == "application/pdf")) { <option value="@asset.Id">@asset.AltText</option> }</select><p class="muted">Upload the file in the media library. Use the description as an accessible text preview of your CV.</p> }
@if (Model.Kind == "settings") { <h2>Branding & social profiles</h2><label asp-for="Branding.ShortName">Navigation display name</label><input asp-for="Branding.ShortName" maxlength="40" /><label asp-for="Branding.Tagline">Footer tagline</label><input asp-for="Branding.Tagline" maxlength="80" /><label asp-for="Branding.GitHubUrl">GitHub profile (HTTPS)</label><input asp-for="Branding.GitHubUrl" type="url" /><label asp-for="Branding.LinkedInUrl">LinkedIn profile (HTTPS)</label><input asp-for="Branding.LinkedInUrl" type="url" /> }
<button class="button primary">Save entry</button></form>
