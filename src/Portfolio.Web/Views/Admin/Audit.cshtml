@model List<AuditEvent>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Activity history"; }
<p class="eyebrow">ACCOUNTABILITY</p><h1>Activity history</h1><p>Latest 200 events. Content, credentials and contact messages are excluded from this log. Retained for one year.</p><div class="panel table-wrap"><table><thead><tr><th>Time (UTC)</th><th>Action</th><th>Record</th><th>Actor</th></tr></thead><tbody>@foreach (var a in Model.OrderByDescending(x => x.CreatedAt)) { <tr><td>@a.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td><td>@a.Action</td><td>@a.EntityId</td><td>@a.ActorId</td></tr> }</tbody></table></div>
