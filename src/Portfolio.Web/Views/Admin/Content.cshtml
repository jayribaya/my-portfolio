@model ContentListModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = Model.Kind; var items = Model.Order == null ? Model.Items : Model.Order.Ids.Select(id => Model.Items.Single(x => x.Id == id)).ToList(); }
<div class="section-heading"><div><p class="eyebrow">CONTENT STUDIO</p><h1>@(char.ToUpper(Model.Kind[0]) + Model.Kind[1..])</h1><p>Edit content, control visibility, and keep your story current.</p></div><a class="button primary" href="/admin/content/@Model.Kind/new">+ Add entry</a></div>
<div class="panel order-panel" data-endpoint="/admin/api/sections/reorder" data-version="@(Model.Order?.Version ?? 0)" data-disabled="@((Model.Order == null).ToString().ToLowerInvariant())"><ul class="sortable-list" data-sortable>@foreach (var item in items) { <li data-id="@item.Id">@if (Model.Order != null) { <span class="drag-handle" aria-hidden="true">⠿</span><button type="button" class="move-up icon-button" aria-label="Move @item.Title up">↑</button><button type="button" class="move-down icon-button" aria-label="Move @item.Title down">↓</button> }<div class="grow"><a href="/admin/content/@Model.Kind/@item.Id/edit">@item.Title</a><p class="muted">@item.Key @item.Subtitle</p></div><span class="badge">@(item.IsEnabled ? "Visible" : "Hidden")</span><a href="/admin/content/@Model.Kind/@item.Id/edit">Edit</a><form method="post" action="/admin/content/@item.Id/delete" data-confirm="Permanently delete this content entry?">@Html.AntiForgeryToken()<input type="hidden" name="version" value="@item.Version" /><button class="button small danger">Delete</button></form></li> }</ul>@if (Model.Order != null) { <button class="save-order button primary" type="button">Save section order</button> }@if (!items.Any()) { <p class="empty">No entries yet. Add the first one above.</p> }</div>
