@model OrderingModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Order " + Model.Order.Id; }
<a href="/admin/projects" class="text-link">← Projects</a><p class="eyebrow">DISPLAY ORDER / @Model.Order.Id</p><h1>Put your best work first</h1><p>This complete list is independent of gallery filters and pagination. Drag handles or use ↑ / ↓, then save. Changes are version checked.</p><div class="actions"><a href="/admin/order/projects">All projects</a><a href="/admin/order/featured">Featured projects</a><a href="/admin/order/sections">Homepage sections</a></div><section class="panel order-panel" data-endpoint="/admin/api/@Model.Order.Id/reorder" data-version="@Model.Order.Version"><ul class="sortable-list" data-sortable>@foreach (var id in Model.Order.Ids) { <li data-id="@id"><span class="drag-handle" aria-hidden="true">⠿</span><strong class="grow">@Model.Titles[id]</strong><button type="button" class="move-up icon-button" aria-label="Move @Model.Titles[id] up">↑</button><button type="button" class="move-down icon-button" aria-label="Move @Model.Titles[id] down">↓</button></li> }</ul><button class="save-order button primary" type="button">Save order</button></section>
