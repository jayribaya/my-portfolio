@model DashboardModel
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Overview"; }
<div class="section-heading"><div><p class="eyebrow">PORTFOLIO STUDIO</p><h1>Make your work shine<span class="blue">.</span></h1><p>Everything you need to keep your portfolio fresh.</p></div><a class="button primary" href="/admin/projects/new">+ New project</a></div>
<div class="stat-grid">@foreach (var stat in new[] { ("Total projects", Model.Projects.Count(x => x.DeletedAt == null)), ("Published", Model.Projects.Count(x => x.IsPublic)), ("Drafts", Model.Projects.Count(x => x.Visibility == Visibility.Draft && x.DeletedAt == null)), ("Unread messages", Model.Unread) }) { <div class="panel stat"><p class="eyebrow">@stat.Item1</p><strong>@stat.Item2.ToString("D2")</strong></div> }</div>
<div class="split dashboard-panels"><section class="panel"><div class="section-heading"><h2>Recent projects</h2><a href="/admin/projects">Manage →</a></div>@foreach (var p in Model.Projects.OrderByDescending(x => x.UpdatedAt).Take(5)) { <div class="list-row"><div><a href="/admin/projects/@p.Id/edit">@p.Title</a><p class="muted">Updated @p.UpdatedAt.ToString("MMM d, yyyy")</p></div><span class="badge">@p.Visibility</span></div> }</section><section class="panel"><h2>Recent activity</h2>@foreach (var audit in Model.Audit.OrderByDescending(x => x.CreatedAt).Take(7)) { <div class="list-row"><span>@audit.Action</span><time class="muted">@audit.CreatedAt.ToString("MMM d HH:mm") UTC</time></div> }@if (!Model.Audit.Any()) { <p class="empty">Your content changes will appear here.</p> }<a href="/admin/audit">All activity →</a></section></div><p><a class="text-link" href="/admin/export">Export portfolio content (JSON) ↓</a></p>
