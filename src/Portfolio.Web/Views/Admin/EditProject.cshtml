@model Project
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Project editor"; var media = (List<MediaAsset>)ViewData["Media"]!; var categories = (List<ContentItem>)ViewData["Categories"]!; var technologies = (List<ContentItem>)ViewData["Technologies"]!; }
<a class="text-link" href="/admin/projects">← Projects</a><div class="section-heading"><div><p class="eyebrow">PROJECT EDITOR</p><h1>@(Model.Version == 0 ? "A new piece of work" : Model.Title)</h1></div>@if (Model.Version > 0) { <a class="button secondary" href="/admin/projects/@Model.Id/preview">Preview ↗</a> }</div>
<form method="post" action="/admin/projects/save" class="editor form-stack">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><input asp-for="Version" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div>
<section class="panel"><h2>The essentials</h2><div class="form-grid"><div><label asp-for="Title"></label><input asp-for="Title" required maxlength="120" /><span asp-validation-for="Title"></span></div><div><label asp-for="Slug"></label><input asp-for="Slug" placeholder="Auto-generated if blank" maxlength="140" /></div></div><label asp-for="Summary"></label><textarea asp-for="Summary" rows="3" required maxlength="400"></textarea><label asp-for="Description"></label><textarea asp-for="Description" rows="6" maxlength="12000"></textarea><div class="form-grid"><div><label asp-for="Visibility"></label><select asp-for="Visibility" asp-items="Html.GetEnumSelectList<Visibility>()"></select></div><div><label asp-for="ProjectStatus">Work status</label><select asp-for="ProjectStatus" asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select></div><div><label asp-for="StartDate"></label><input asp-for="StartDate" type="date" /></div><div><label asp-for="EndDate"></label><input asp-for="EndDate" type="date" /></div></div><label class="checkbox"><input asp-for="IsFeatured" /> Pin in featured work</label><p class="muted">Work status describes progress. Visibility controls publication. Archived and deleted work stays private.</p></section>
<section class="panel"><h2>The case study</h2><label asp-for="ProblemStatement">Business or community problem</label><textarea asp-for="ProblemStatement" rows="4"></textarea><label asp-for="Solution"></label><textarea asp-for="Solution" rows="4"></textarea><label asp-for="Role"></label><input asp-for="Role" /><label asp-for="Architecture"></label><textarea asp-for="Architecture" rows="5"></textarea>
@foreach (var field in new[] { ("Responsibilities", Model.Responsibilities), ("Features", Model.Features), ("Outcomes", Model.Outcomes), ("Technologies", Model.Technologies), ("Tags", Model.Tags) }) { <label for="list-@field.Item1">@field.Item1 (one per line)</label><textarea id="list-@field.Item1" data-array-name="@field.Item1" rows="4">@string.Join("\n", field.Item2)</textarea><div data-array-values="@field.Item1">@for (var i = 0; i < field.Item2.Length; i++) { <input type="hidden" name="@(field.Item1 + "[" + i + "]")" value="@field.Item2[i]" /> }</div> }
@if (technologies.Any()) { <p class="muted">Managed technology vocabulary: @string.Join(", ", technologies.Select(x => x.Title))</p> }
<fieldset><legend>Categories</legend>@foreach (var c in categories) { <label class="checkbox"><input type="checkbox" name="CategoryIds" value="@c.Id" checked="@Model.CategoryIds.Contains(c.Id)" /> @c.Title</label> }</fieldset></section>
<section class="panel"><h2>Images & gallery</h2><p>Upload assets in the <a href="/admin/media">media library</a>, then assign them here. Draft assets are private; assets shared with a published project are public.</p><label asp-for="CoverImageId">Cover image</label><select asp-for="CoverImageId"><option value="">No cover image</option>@foreach (var asset in media.Where(x => x.ContentType.StartsWith("image/"))) { <option value="@asset.Id">@asset.AltText</option> }</select><fieldset><legend>Gallery images (library order)</legend><div class="media-picker">@foreach (var asset in media.Where(x => x.ContentType.StartsWith("image/"))) { <label><img src="@asset.Url" alt="@asset.AltText" loading="lazy" /><span><input type="checkbox" name="GalleryImageIds" value="@asset.Id" checked="@Model.GalleryImageIds.Contains(asset.Id)" /> @asset.AltText</span></label> }</div></fieldset></section>
<section class="panel"><h2>Links & search appearance</h2><div class="form-grid"><div><label asp-for="GitHubUrl">GitHub URL (HTTPS)</label><input asp-for="GitHubUrl" type="url" /></div><div><label asp-for="DemoUrl">Demo URL (HTTPS)</label><input asp-for="DemoUrl" type="url" /></div><div><label asp-for="CaseStudyUrl">Case study URL (HTTPS)</label><input asp-for="CaseStudyUrl" type="url" /></div><div><label asp-for="SeoTitle">SEO title</label><input asp-for="SeoTitle" maxlength="70" /></div></div><label asp-for="SeoDescription">SEO description</label><textarea asp-for="SeoDescription" maxlength="170" rows="2"></textarea></section><div class="sticky-save"><span class="muted">Text is safely encoded. Plain text only.</span><button class="button primary">Save project</button></div></form>
