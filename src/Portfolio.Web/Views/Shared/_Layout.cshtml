@inject IPortfolioStore Store
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{ var settings = (await Store.Content("settings", Context.RequestAborted)).FirstOrDefault(x => x.IsEnabled); var name = settings?.Title ?? "Jay Carlo C. Ribaya"; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · @name</title><meta name="description" content="@(ViewData["Description"] ?? settings?.Content ?? "Software engineering portfolio")" /><meta name="color-scheme" content="dark light" /><meta property="og:title" content="@ViewData["Title"] · @name" /><meta property="og:description" content="@(ViewData["Description"] ?? settings?.Content)" /><meta property="og:type" content="website" /><link rel="canonical" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><script type="module" src="~/js/site.js" asp-append-version="true"></script></head><body><a href="#main" class="skip-link">Skip to content</a><header class="site-header"><nav class="wrap nav" aria-label="Main navigation"><a class="brand" href="/" aria-label="Jay Carlo home"><span class="brand-mark">j<span class="blue">.</span></span><span>@(settings?.Branding.ShortName ?? "JAY CARLO")<span class="brand-sub">@(settings?.Subtitle ?? "SOFTWARE ENGINEER")</span></span></a><button type="button" class="mobile-toggle icon-button" aria-expanded="false" aria-controls="main-nav">Menu ☰</button><div class="nav-links" id="main-nav"><a href="/about">About</a><a href="/projects">Work</a><a href="/skills">Toolkit</a><a href="/experience">Experience</a><a href="/resume">CV ↓</a><a class="nav-contact" href="/contact">Let’s talk ↗</a></div><button class="theme-toggle icon-button" type="button" aria-label="Switch color theme">◐</button></nav></header>
@if (Config.GetValue<bool>("DemoMode")) { <div class="demo-banner">Development preview · Illustrative content · Changes are held in memory and reset on restart</div> }
@if (TempData["Message"] is string message) { <div class="wrap notice" role="status">@message</div> }
<main id="main">@RenderBody()</main><footer class="wrap site-footer"><div><a class="brand-mark" href="/" aria-label="Home">j<span class="blue">.</span></a><p>@(settings?.Branding.Tagline ?? "Thoughtfully designed. Carefully engineered.")</p></div><div><p>© @DateTime.UtcNow.Year @name</p><a href="/education">Education</a> · <a href="/certifications">Certifications</a> · <a href="/articles">Notes</a> · <a href="/admin">Studio ↗</a></div></footer>@await RenderSectionAsync("Scripts", required: false)</body></html>
