@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{ var token = Antiforgery.GetAndStoreTokens(Context).RequestToken; }
<!DOCTYPE html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" /><meta name="csrf-token" content="@token" /><title>@ViewData["Title"] · Portfolio Studio</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /><script type="module" src="~/js/site.js" asp-append-version="true"></script></head><body class="admin-body"><a href="#main" class="skip-link">Skip to content</a><aside class="admin-sidebar"><a class="brand" href="/admin"><span class="brand-mark">j<span class="blue">.</span></span><span>PORTFOLIO<span class="brand-sub">CONTENT STUDIO</span></span></a><p class="eyebrow">WORKSPACE</p><nav aria-label="Admin navigation"><a href="/admin">Overview</a><a href="/admin/projects">Projects</a><a href="/admin/content/sections">Homepage sections</a><a href="/admin/content/categories">Categories</a><a href="/admin/content/technologies">Technologies</a><a href="/admin/content/skills">Skills</a><a href="/admin/content/experience">Experience</a><a href="/admin/content/education">Education</a><a href="/admin/content/certifications">Certifications</a><a href="/admin/media">Media library</a><a href="/admin/content/resume">Resume</a><a href="/admin/content/articles">Articles</a><a href="/admin/contacts">Contact inbox</a><a href="/admin/content/settings">Site & branding</a><a href="/admin/audit">Activity history</a><a href="/admin/security">Profile & security</a></nav><a class="text-link" href="/">View portfolio ↗</a><form method="post" action="/admin/logout">@Html.AntiForgeryToken()<button class="button secondary">Sign out</button></form></aside><div class="admin-workspace"><header class="admin-topbar"><span class="eyebrow">YOUR WORK. YOUR STORY.</span><div><button class="theme-toggle icon-button" type="button" aria-label="Switch color theme">◐</button><span>@User.Identity?.Name</span></div></header><main id="main" class="admin-main">@if (TempData["Message"] is string message) { <div class="notice" role="status">@message</div> }@RenderBody()</main></div><div id="order-status" class="toast" role="status" aria-live="polite"></div><dialog id="confirm-dialog"><h2>Confirm this change</h2><p id="confirm-message">Do you want to continue?</p><div class="actions"><button type="button" id="confirm-cancel" class="button secondary">Cancel</button><button type="button" id="confirm-ok" class="button primary">Confirm</button></div></dialog></body></html>
