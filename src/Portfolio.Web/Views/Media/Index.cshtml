@model List<MediaAsset>
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Media library"; }
<p class="eyebrow">ASSETS</p><h1>Media library</h1><p>Stored durably in MongoDB GridFS. Assets become public only when referenced by a published project or enabled resume.</p><form method="post" action="/admin/media/upload" enctype="multipart/form-data" class="panel form-stack">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation" role="alert"></div><label for="files">Choose images or PDFs (up to 4 files, 8 MB each)</label><input id="files" name="files" type="file" multiple accept="image/png,image/jpeg,image/webp,application/pdf" required /><label for="altText">Describe these assets for screen readers</label><input id="altText" name="altText" maxlength="300" required /><div id="upload-previews" class="media-picker" aria-live="polite"></div><button class="button primary">Upload files</button></form><div class="media-library">@foreach (var asset in Model) { <article class="panel">@if (asset.ContentType.StartsWith("image/")) { <img src="@asset.Url" alt="@asset.AltText" loading="lazy" /> } else { <div class="pdf-icon" aria-hidden="true">PDF ↓</div> }<h3>@asset.AltText</h3><p class="muted">@asset.ContentType · @((asset.Size / 1024).ToString()) KB</p><a class="text-link" href="@asset.Url">View asset ↗</a></article> }</div>@if (!Model.Any()) { <p class="empty">No uploads yet. Start with a cover image or your CV.</p> }
