@model PasswordForm
@{ Layout = "_AdminLayout"; ViewData["Title"] = "Profile & security"; }
<p class="eyebrow">YOUR ACCOUNT</p><h1>Profile & security</h1><p>Signed in as @User.Identity?.Name. Password changes invalidate all existing sessions.</p><form method="post" action="/admin/security" class="panel form-stack narrow">@Html.AntiForgeryToken()<div asp-validation-summary="All" class="validation" role="alert"></div><label asp-for="CurrentPassword">Current password</label><input asp-for="CurrentPassword" type="password" autocomplete="current-password" /><label asp-for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password" /><p class="muted">Use 14+ characters, uppercase and lowercase letters, a number and a symbol.</p><button class="button primary">Update password</button></form>
